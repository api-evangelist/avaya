<?xml version="1.0" encoding="utf-8"?>

<wsdl:definitions name="StatsNotificationProducer"
	xmlns="http://schemas.xmlsoap.org/wsdl/"
	xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
	xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"  
	xmlns:tns="http://www.nortel.com/soa/oi/cct/StatsNotificationProducer"
	targetNamespace="http://www.nortel.com/soa/oi/cct/StatsNotificationProducer">

	<wsdl:import 
		namespace="http://www.nortel.com/soa/oi/cct/StatsNotificationProducer"
		location="StatsNotificationProducerInterface.wsdl" />       
       
	<binding name="StatsNotificationProducerSoapBinding" type="tns:StatsNotificationProducer">
		<soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
		<wsdl:operation name="Subscribe">
			<soap:operation soapAction="http://www.nortel.com/soa/oi/cct/StatsNotificationProducer/service/Subscribe"/> 
			<wsdl:input name="SubscribeRequest">
                <soap:body use="literal"/>
            </wsdl:input>
            <wsdl:output name="SubscribeResponse">
                <soap:body use="literal"/>
            </wsdl:output>
            <wsdl:fault name="ResourceUnknownFault">
				<soap:fault name="ResourceUnknownFault" use="literal"/>
			</wsdl:fault> 
            <wsdl:fault name="SubscribeCreationFailedFault">
				<soap:fault name="SubscribeCreationFailedFault" use="literal"/>
			</wsdl:fault> 
            <wsdl:fault name="TopicPathDialectUnknownFault">
				<soap:fault name="TopicPathDialectUnknownFault" use="literal"/>
			</wsdl:fault> 
        </wsdl:operation>
        
		<wsdl:operation name="Renew">
			<soap:operation soapAction="http://www.nortel.com/soa/oi/cct/StatsNotificationProducer/service/Renew"/> 
			<wsdl:input name="RenewRequest">
                <soap:body use="literal"/>
            </wsdl:input>
            <wsdl:output name="RenewResponse">
                <soap:body use="literal"/>
            </wsdl:output>  
			<wsdl:fault name="ResourceUnknownFault">
				<soap:fault name="ResourceUnknownFault" use="literal"/>
			</wsdl:fault> 
            <wsdl:fault name="RenewSubscriptionFailedFault">
				<soap:fault name="RenewSubscriptionFailedFault" use="literal"/>
			</wsdl:fault> 
            <wsdl:fault name="UnacceptableTerminationTimeFault">
				<soap:fault name="UnacceptableTerminationTimeFault" use="literal"/>
			</wsdl:fault> 
        </wsdl:operation>       

		<wsdl:operation name="Unsubscribe">
			<soap:operation soapAction="http://www.nortel.com/soa/oi/cct/StatsNotificationProducer/service/Unsubscribe"/>
			<wsdl:input name="UnsubscribeRequest">
                <soap:body use="literal"/>
            </wsdl:input>
            <wsdl:output name="UnsubscribeResponse">
                <soap:body use="literal"/>
            </wsdl:output>     
			<wsdl:fault name="ResourceUnknownFault">
				<soap:fault name="ResourceUnknownFault" use="literal"/>
			</wsdl:fault> 
            <wsdl:fault name="UnableToDestroySubscriptionFault">
				<soap:fault name="UnableToDestroySubscriptionFault" use="literal"/>
			</wsdl:fault>                    
        </wsdl:operation>       
 
    </binding>
    
	<service name="SOAOICCT_StatsNotificationProducer">
        <port name="StatsNotificationProducer" binding="tns:StatsNotificationProducerSoapBinding">
	        <soap:address location="http://localhost:9080/SOAOICCT/services/StatsNotificationProducer"/>
        </port>
    </service>
    
</wsdl:definitions>
