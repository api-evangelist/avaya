				</xsd:sequence>
			</xsd:complexType>

			<xsd:complexType name="GetCapabilitiesResponse">
				<xsd:sequence>
					<xsd:element name="agentCapabilities" type="types:agentCapabilities" />
				</xsd:sequence>
			</xsd:complexType>

			<xsd:complexType name="LoginRequest">
				<xsd:sequence>
					<xsd:element name="ssoToken" type="types:ssoToken" />
					<xsd:element name="agent" type="types:agent" />
					<xsd:element name="password" type="xsd:string" />
					<!-- EoinMc, pass in enum AgentReadyStatus instead of int -->
					<!-- <xsd:element name="initialState" type="xsd:int"/>  -->
					<xsd:element name="initialState" type="types:agentReadyStatus"/>
				</xsd:sequence>
			</xsd:complexType>

