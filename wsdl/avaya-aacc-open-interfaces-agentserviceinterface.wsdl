				</xsd:sequence>
			</xsd:complexType>

			<xsd:complexType name="RetrieveResponse">
				<xsd:sequence>
					<xsd:element name="contact" type="types:contact" />
				</xsd:sequence>
			</xsd:complexType>

			<xsd:complexType name="StringResponse">
				<xsd:sequence>
