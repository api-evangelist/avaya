			<xsd:element name="SetIsReadyRequest" type="local:BooleanTerminalRequest" />
			
			<xsd:element name="GetLoginIdRequest" type="local:TerminalRequest" />
			<xsd:element name="GetLoginIdResponse" type="local:GetLoginIdResponse" />
			
			<xsd:element name="GetNotReadyReasonCodeRequest" type="local:TerminalRequest" />
			<xsd:element name="GetNotReadyReasonCodeResponse" type="local:GetNotReadyReasonCodeResponse" />
			
			<xsd:element name="SetNotReadyReasonCodeRequest" type="local:StringTerminalRequest" />
			<xsd:element name="LoginRequest" type="local:AgentTerminalLoginRequest" />
			<xsd:element name="LogoutRequest" type="local:AgentTerminalLogoutRequest" />

			<xsd:element name="SetActivityCodeRequest" type="local:SetActivityCodeRequest" />
						
			<xsd:element name="CallSupervisorRequest" type="local:TerminalAddressRequest" />

		</xsd:schema>
	</wsdl:types>

	<wsdl:message name="GetVersionRequest">
		<wsdl:part name="parameters" element="local:GetVersionRequest" />
	</wsdl:message>
	<wsdl:message name="GetVersionResponse">
		<wsdl:part name="response" element="local:GetVersionResponse" />
