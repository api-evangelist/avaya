				<xsd:sequence>
					<xsd:element name="ssoToken" type="types:ssoToken" />
					<xsd:element name="terminal" type="types:terminal" />
					<xsd:element name="address" type="types:address" />
				</xsd:sequence>
			</xsd:complexType>


			<xsd:element name="GetVersionRequest" type="types:getVersionRequest" />
			<xsd:element name="GetVersionResponse" type="types:getVersionResponse" />

			<xsd:element name="GetCapabilitiesRequest" type="local:TerminalRequest" />
			<xsd:element name="GetCapabilitiesResponse" type="local:GetAgentTerminalCapabilitiesResponse" />

			<xsd:element name="GetTerminalConnectionsRequest" type="local:TerminalRequest" />
			<xsd:element name="GetTerminalConnectionsResponse" type="local:GetTerminalConnectionsResponse" />

			<xsd:element name="GetRelatedAddressesRequest" type="local:TerminalRequest" />
			<xsd:element name="GetRelatedAddressesResponse" type="local:GetRelatedAddressesResponse" />

			<xsd:element name="GetDoNotDisturbRequest" type="local:TerminalRequest" />
			<xsd:element name="GetDoNotDisturbResponse" type="local:GetDoNotDisturbResponse" />

			<xsd:element name="IsForwardedRequest" type="local:TerminalRequest" />
			<xsd:element name="IsForwardedResponse" type="local:IsForwardedResponse" />
			
			<xsd:element name="GetActivityCodeRequest" type="local:TerminalRequest" />
