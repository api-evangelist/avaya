			</xsd:complexType>
			
			<xsd:complexType name="GetNotReadyReasonCodeResponse">
				<xsd:sequence>
					<xsd:element name="notReadyReasonCode" type="xsd:string" />
				</xsd:sequence>
			</xsd:complexType>
			
			<xsd:complexType name="IsReadyResponse">
				<xsd:sequence>
					<xsd:element name="isReady" type="xsd:boolean" />
				</xsd:sequence>
			</xsd:complexType>
			
			
			<xsd:complexType name="AgentTerminalLoginRequest">
				<xsd:sequence>
					<xsd:element name="ssoToken" type="types:ssoToken"/>					
					<xsd:element name="agentTerminal" type="types:terminal"/>
					<xsd:element name="agentId" type="xsd:string"/>
					<xsd:element name="password" type="xsd:string"/>
					<!-- EoinMc, pass in enum AgentReadyStatus instead of int -->
					<!-- <xsd:element name="initialState" type="xsd:int"/>  -->
					<xsd:element name="initialState" type="types:agentReadyStatus"/>
				</xsd:sequence>
			</xsd:complexType>
			
			<xsd:complexType name="AgentTerminalLogoutRequest">
				<xsd:sequence>
					<xsd:element name="ssoToken" type="types:ssoToken"/>					
