    "protocol": {
     "enum": [
      "http",
      "https"
     ],
     "default": "http"
    },
    "server": {
     "default": "timetable-service"
    },
    "port": {
     "enum": [
      "80",
      "443"
     ],
     "default": "80"
    }
   }
  }
 ],
